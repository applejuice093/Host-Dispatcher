{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Desktop app, core, and tests",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "core",
      "displayName": "Core and tests only (no Qt needed)",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "HOST_DISPATCHER_BUILD_GUI": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Release" },
    { "name": "core", "configurePreset": "core", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "core", "configurePreset": "core", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
